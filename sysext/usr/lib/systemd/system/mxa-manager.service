[Unit]
Description=MemryX MX3 device management daemon (mxa-manager)
# Adapted from MemryX's upstream debian_manager/mxa-manager.service
# (memryx/MxAccl). Differences from upstream, for the TrueNAS sysext context:
#   * After=memryx-load.service — the daemon opens /dev/memx0, which the
#     sibling oneshot insmods. Upstream relies on the module already being
#     present from a DKMS install; here we load it ourselves on boot.
#   * Before=docker.service — Frigate (and any MX3 container) connects to the
#     /run/mxa_manager socket this daemon creates. TrueNAS apps boot as
#     docker `restart=unless-stopped` containers, so a container that starts
#     before the socket exists would fail to reach the accelerator. The
#     sibling sysexts (hailo-load, coral-load, nvidia-mig-setup) order
#     themselves Before=docker.service the same way.
#   * User=root instead of upstream's dedicated `mxa-manager` sysuser: a
#     sysext-shipped sysusers.d entry isn't reliably created before the
#     sysext is merged by the PREINIT path on TrueNAS, so the dedicated user
#     may not exist when this unit starts. /dev/memx0 is 0666 and
#     /run/mxa_manager is 0777, so root is functionally equivalent here.
#   * mxa_manager hardcodes its config path to /etc/memryx/mxa_manager.conf
#     (no --config flag) and the SDK 2.1 binary reads it UNCONDITIONALLY and
#     exits `critical` if it's missing — passing CLI flags does not skip it
#     (only newer MxAccl builds branch on argc). A sysext can't ship /etc, so
#     the conf is bundled at /usr/lib/memryx/mxa_manager.conf and the first
#     ExecStartPre below copies it into /etc/memryx/ on every start (TrueNAS
#     /etc is writable; the copy is recreated each start, so it need not
#     persist across reboots or TrueNAS updates).
After=local-fs.target memryx-load.service
Requires=memryx-load.service
Before=docker.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
# Materialize the config the daemon hardcodes (see header). The bundled copy
# lives in the merged sysext at /usr/lib/memryx/mxa_manager.conf.
ExecStartPre=/bin/bash -c 'mkdir -p /etc/memryx && cp -f /usr/lib/memryx/mxa_manager.conf /etc/memryx/mxa_manager.conf'
# Bounded wait for the device node the daemon manages. memryx-load.service
# has already run (insmod), but udev may take a moment to create /dev/memx0.
# Give it up to ~15s; if the card is absent the daemon would exit and
# Restart=on-failure would land us in `failed` after the burst cap above,
# rather than tight-looping.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 15); do [ -e /dev/memx0 ] && exit 0; sleep 1; done; echo "mxa-manager: /dev/memx0 not present after 15s" >&2; exit 1'
ExecStart=/usr/bin/mxa_manager
Restart=on-failure
RestartSec=2
# Creates /run/mxa_manager (0777) — Frigate bind-mounts this into the
# container (-v /run/mxa_manager:/run/mxa_manager).
RuntimeDirectory=mxa_manager
RuntimeDirectoryMode=0777

[Install]
WantedBy=multi-user.target
